[submodule "riscv-linux"]
	path = boards/default/linux
	url = https://github.com/firesim/linux.git
[submodule "opensbi"]
	path = boards/default/firmware/opensbi
	url = https://github.com/riscv/opensbi.git
[submodule "boards/default/distros/br/buildroot"]
	path = boards/default/distros/br/buildroot
	url = https://github.com/buildroot/buildroot.git
[submodule "wlutil/busybox"]
	path = wlutil/busybox
	url = https://github.com/mirror/busybox.git
[submodule "boards/firechip/drivers/icenet-driver"]
	path = boards/firechip/drivers/icenet-driver
	url = https://github.com/firesim/icenet-driver.git
[submodule "boards/firechip/drivers/iceblk-driver"]
	path = boards/firechip/drivers/iceblk-driver
	url = https://github.com/firesim/iceblk-driver.git
[submodule "boards/firechip/base-workloads/workloads/relational-memory-fsim"]
	path = boards/firechip/base-workloads/workloads/relational-memory-fsim
	url = https://github.com/ColeStrickler/relational-memory-fsim.git
[submodule "boards/firechip/base-workloads/workloads/matmul"]
	path = boards/firechip/base-workloads/workloads/matmul
	url = https://github.com/ColeStrickler/dtl_benchmarks.git
[submodule "boards/firechip/base-workloads/workloads/dtu-driver"]
	path = boards/firechip/base-workloads/workloads/dtu-driver
	url = https://github.com/ColeStrickler/dtu-runtime-driver.git
